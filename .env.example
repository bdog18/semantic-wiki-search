# Copy to .env and adjust. All settings are optional; defaults live in
# src/swsearch/config.py, which also carries the measurements behind each
# non-obvious default. Nested settings use a double-underscore delimiter:
# SWSEARCH_<GROUP>__<FIELD>.
#
# Every value below is commented out -- uncommenting one overrides the
# default, it does not merge with it.

# Where all data lives. Defaults to <repo_root>/data (absolute, not
# CWD-relative), so commands work from any working directory. Point it at a
# scratch directory to run the whole pipeline without touching real data:
#   SWSEARCH_PATHS__DATA_ROOT=/tmp/scratch swsearch extract
# SWSEARCH_PATHS__DATA_ROOT=/mnt/E/Repos/semantic-wiki-search/data

# --- Spark (used by extract / build-linkgraph / embed) ---
# Defaults are conservative for dev/small-scale runs. Bump for full-corpus runs.
# SWSEARCH_SPARK__DRIVER_MEMORY=50g
# SWSEARCH_SPARK__MAX_RESULT_SIZE=15g
# SWSEARCH_SPARK__SHUFFLE_PARTITIONS=100
# SWSEARCH_SPARK__LOCAL_DIR=spark-temp

# --- Embedding model ---
# SWSEARCH_MODEL__EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
# device auto-detects cuda if a GPU is visible to torch, else cpu. Override to
# force one or the other:
# SWSEARCH_MODEL__DEVICE=cpu
# SWSEARCH_MODEL__USE_GPU_FAISS=false

# --- Reranking (title match + backlink authority) ---
# Off by default so `swsearch search`/`evaluate` need an explicit --rerank;
# it is worth turning on -- reranked MRR is 0.7947 against 0.3767 raw.
# SWSEARCH_RERANK__ENABLED=false
# SWSEARCH_RERANK__TITLE_MATCH_WEIGHT=0.5
# SWSEARCH_RERANK__BACKLINK_WEIGHT=0.3
# The ~99th-percentile backlink count, the denominator that normalizes
# log(1 + backlinks) into roughly 0-1. Pinned rather than derived at startup
# because computing it sorts the whole 1.3GB backlinks table (23.2s). Set to 0
# to force that query back on -- do that after rebuilding the backlink counts,
# then pin the answer here.
# SWSEARCH_RERANK__MAX_BACKLINK_COUNT=540

# --- Triplet mining ---
# The rank band negatives are drawn from. Sampling from the top of the
# neighbour list (the old 0-10 behaviour) makes the "negatives" the most
# relevant paragraphs in the corpus; 66% of them scored above their own paired
# positive, which is why fine-tuning lost to baseline. See MiningSettings in
# config.py for the per-band measurements.
# SWSEARCH_MINING__NEGATIVE_RANK_MIN=1000
# SWSEARCH_MINING__NEGATIVE_RANK_MAX=2000
# SWSEARCH_MINING__NEGATIVE_POOL_SIZE=10
# IVF cells probed when searching that band. The index ships nprobe=10, which
# is fine for top-10 retrieval but too narrow to rank 1000 deep reliably.
# SWSEARCH_MINING__NEGATIVE_SEARCH_NPROBE=32
# 0.0 => always anchor on the article title, the distribution every run that
# beat baseline actually used. Raising it opts into lead-sentence anchors,
# measured as worse.
# SWSEARCH_MINING__SENTENCE_ANCHOR_PROBABILITY=0.0
# SWSEARCH_MINING__MAX_TRIPLETS_PER_ARTICLE=10
# SWSEARCH_MINING__BATCH_SIZE=128

# --- Serving ---
# The HTTP API reads its own SWSEARCH_API_* variables (index/metadata/model
# paths, api key, mmap) directly from the environment rather than through
# Settings, since they point at wherever a container staged its artifacts.
# They are documented where they are set: docker/api.Dockerfile,
# docker/lambda.Dockerfile, and src/swsearch/api/app.py.
