# Copy to .env and adjust. All settings are optional; defaults live in src/swsearch/config.py.
# Nested settings use a double-underscore delimiter: SWSEARCH_<GROUP>__<FIELD>.

# Where all data lives. Defaults to <repo_root>/data (absolute, not CWD-relative).
# SWSEARCH_PATHS__DATA_ROOT=/mnt/E/Repos/semantic-wiki-search/data

# --- Spark (used by extract/build-linkgraph/embed) ---
# Defaults are conservative for dev/small-scale runs. Bump for full-corpus (~10M article) runs.
# SWSEARCH_SPARK__DRIVER_MEMORY=50g
# SWSEARCH_SPARK__MAX_RESULT_SIZE=15g
# SWSEARCH_SPARK__SHUFFLE_PARTITIONS=100
# SWSEARCH_SPARK__LOCAL_DIR=spark-temp

# --- Embedding model ---
# SWSEARCH_MODEL__EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
# device auto-detects cuda if a GPU is visible to torch, else cpu -- override to force one or the other:
# SWSEARCH_MODEL__DEVICE=cpu
# SWSEARCH_MODEL__USE_GPU_FAISS=false

# --- Triplet mining ---
# SWSEARCH_MINING__MAX_TRIPLETS_PER_ARTICLE=10
# SWSEARCH_MINING__NEGATIVE_POOL_SIZE=10
# SWSEARCH_MINING__BATCH_SIZE=128
